[Unit]
Description=Rising Crescent web (Nginx HTTPS)
Requires=docker.service risingcrescent-api.service
After=docker.service risingcrescent-api.service
PartOf=risingcrescent.target

[Service]
Type=simple
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=20
WorkingDirectory=/home/ec2-user/risingcrescent
EnvironmentFile=-/home/ec2-user/risingcrescent/.env
ExecStart=/usr/bin/docker compose up --no-color --no-log-prefix --no-deps web
ExecStop=/usr/bin/docker compose stop web
StandardOutput=journal
StandardError=journal
SyslogIdentifier=risingcrescent-web

[Install]
WantedBy=risingcrescent.target
