[Unit]
Description=Shining Crescent PostgreSQL
Requires=docker.service
After=docker.service
PartOf=shiningcrescent.target

[Service]
Type=simple
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30
WorkingDirectory=/home/ec2-user/shiningcrescent
EnvironmentFile=-/home/ec2-user/shiningcrescent/.env
ExecStart=/usr/bin/docker compose up --no-color --no-log-prefix --no-deps postgres
ExecStop=/usr/bin/docker compose stop postgres
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shiningcrescent-postgres

[Install]
WantedBy=shiningcrescent.target
