[Unit]
Description=Rising Crescent Kafka
Requires=docker.service risingcrescent-postgres.service
After=docker.service risingcrescent-postgres.service
PartOf=risingcrescent.target

[Service]
Type=simple
Restart=always
RestartSec=8
TimeoutStartSec=300
TimeoutStopSec=30
WorkingDirectory=/home/ec2-user/risingcrescent
EnvironmentFile=-/home/ec2-user/risingcrescent/.env
ExecStart=/usr/bin/docker compose up --no-color --no-log-prefix --no-deps kafka
ExecStop=/usr/bin/docker compose stop kafka
StandardOutput=journal
StandardError=journal
SyslogIdentifier=risingcrescent-kafka

[Install]
WantedBy=risingcrescent.target
